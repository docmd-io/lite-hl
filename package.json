{
  "name": "lite-hl",
  "version": "0.2.1",
  "description": "A universal, zero-config, heuristic code tokenizer and highlighter.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./theme.css": "./dist/lite-hl.css"
  },
  "scripts": {
    "build": "tsc && cp src/theme.css dist/lite-hl.css",
    "test": "npm run build >/dev/null && node --test"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "syntax",
    "highlighter",
    "highlight",
    "zero-config",
    "universal",
    "minimalist",
    "fast",
    "lightweight",
    "typescript",
    "javascript",
    "nodejs",
    "browser",
    "docmd"
  ],
  "author": {
    "name": "Ghazi",
    "url": "https://mgks.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/docmd-io/lite-hl.git",
    "directory": "lite-hl"
  },
  "bugs": {
    "url": "https://github.com/docmd-io/lite-hl/issues"
  },
  "homepage": "https://docmd.io",
  "funding": "https://github.com/sponsors/mgks",
  "license": "MIT"
}